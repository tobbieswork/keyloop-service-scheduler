{
  "name": "keyloop-service-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Service Scheduler: books service appointments only when a bay and a qualified technician are free (Keyloop Scenario A)",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:concurrency": "vitest run --project integration tests/integration/concurrency.test.ts",
    "lint": "eslint .",
    "lint:api": "redocly lint specs/001-service-scheduler/contracts/openapi.yaml --config specs/001-service-scheduler/contracts/redocly.yaml",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@redocly/cli": "1.34.5",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
